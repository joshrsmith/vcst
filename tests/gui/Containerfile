# An X server (Xvfb), to run the GUI of a simulator without a display. Only the X server runs in the container, the
# simulator runs on the host and connects to it through the X socket directory.
FROM docker.io/library/ubuntu:24.04@sha256:9a04f13b3f80ef056361e30868593b1cfd2279fe19e4081cb93a90bf56819d6a
RUN apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends xvfb \
    && rm -rf /var/lib/apt/lists/*
